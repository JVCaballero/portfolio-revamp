---
import FontFaces from '../components/FontFaces.astro';
import '../styles/global.css';

const title = 'CABALLERO! Portfolio Revamp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Sprint 0 repository foundation for the CABALLERO! portfolio revamp."
    />
    <title>{title}</title>
    <FontFaces />
  </head>
  <body>
    <main>
      <h1>CABALLERO!</h1>
      <p data-sprint="0">
        Sprint 0 foundation is active. The approved Newsstand visual port begins
        in Sprint 1.
      </p>
    </main>
  </body>
</html>
