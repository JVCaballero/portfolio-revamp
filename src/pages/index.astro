---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'CABALLERO! Portfolio Revamp';
const description =
  'Sprint 0 repository foundation for the CABALLERO! portfolio revamp.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <h1>CABALLERO!</h1>
    <p data-sprint="0">
      Sprint 0 foundation is active. The approved Newsstand visual port begins
      in Sprint 1.
    </p>
  </div>
</BaseLayout>
