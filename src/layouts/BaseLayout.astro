---
/*
  Shared document shell. Owns only the universal Newsstand document/frame
  structure: the doctype/html/head skeleton, the shared font declarations,
  and the full-height flex frame the golden master's root wrapper and
  content host establish (Newsstand - Full Site.dc.html, ~lines 31 & 56).

  Background, foreground, default font, container width, and gutter are
  already owned by Sprint 1A (global.css / .container) and are
  intentionally not repeated here. Pages own their own vertical spacing —
  Cover's cadence differs from other editorial pages, so no universal
  page-top/page-bottom padding is introduced.
*/
import { ClientRouter } from 'astro:transitions';
import FontFaces from '../components/FontFaces.astro';
import NewsstandNavigation from '../components/NewsstandNavigation.astro';
import TransitionWipe from '../components/TransitionWipe.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <FontFaces />
    <ClientRouter />
  </head>
  <body class="site-frame">
    <TransitionWipe />
    <NewsstandNavigation />
    <main class="site-main">
      <slot />
    </main>
    <script>
      import { initTransitionWipe } from '../scripts/transition-wipe';
      initTransitionWipe();
    </script>
  </body>
</html>

<style>
  .site-frame {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-main {
    flex: 1 0 auto;
    min-width: 0;
  }
</style>
