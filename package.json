{
  "name": "portfolio-revamp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "astro check",
    "typecheck": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:smoke:desktop": "playwright test tests/smoke.spec.ts --project=desktop",
    "test:visual": "playwright test tests/visual.spec.ts",
    "reference:verify": "node scripts/verify-reference.mjs",
    "reference:baseline": "node scripts/capture-reference-baselines.mjs",
    "repo:verify": "node scripts/verify-structure.mjs && node scripts/verify-reference.mjs",
    "toolchain:verify": "node scripts/verify-toolchain.mjs",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "cf:preview": "pnpm build && wrangler versions upload"
  },
  "dependencies": {
    "@astrojs/mdx": "6.0.3",
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "wrangler": "4.114.0"
  }
}
